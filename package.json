{
  "name": "drop-plugin-sdk-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Drop Plugin SDK monorepo containing @drop-oss/plugin-sdk and @drop-oss/plugin-cli",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "publish:dry-run": "pnpm --filter @drop-oss/plugin-sdk --filter @drop-oss/plugin-cli publish --dry-run --access public --no-git-checks",
    "publish:local": "pnpm --filter @drop-oss/plugin-sdk --filter @drop-oss/plugin-cli publish --access public --no-git-checks",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "prettier": "^3.5.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.68.0"
  }
}
