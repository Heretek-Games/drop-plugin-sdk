{
  "name": "@drop-oss/plugin-sdk",
  "version": "0.6.1",
  "description": "Drop Plugin SDK contract, types, and mock testing harness for Drop OSS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./schema.json": "./schema/drop-plugin.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heretek-Games/drop-plugin-sdk.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/Heretek-Games/drop-plugin-sdk#readme",
  "bugs": {
    "url": "https://github.com/Heretek-Games/drop-plugin-sdk/issues"
  },
  "keywords": [
    "drop",
    "drop-oss",
    "droposs",
    "drop-plugin",
    "plugin-sdk",
    "extensibility",
    "gaming",
    "playnite"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^26.5.1"
  },
  "license": "MIT"
}
