{
  "$schema": "https://droposs.org/schemas/drop-plugin.schema.json",
  "id": "my-fullstack-plugin",
  "name": "My Fullstack Plugin",
  "version": "1.0.0",
  "description": "Drop fullstack plugin with a server REST API, declarative settings, and a Vue client UI",
  "author": "Heretek Games",
  "license": "MIT",
  "apiVersion": 2,
  "targets": [
    "server",
    "client"
  ],
  "trust": "trusted",
  "storageVersion": 1,
  "capabilities": [
    "routes",
    "storage",
    "network",
    "events"
  ],
  "server": {
    "entry": "dist/src/index.js",
    "source": "src/index.ts",
    "capabilities": [
      "routes",
      "storage",
      "network",
      "events"
    ]
  },
  "client": {
    "entry": "dist/src/client.js",
    "source": "src/client.ts",
    "capabilities": [
      "ui:slot",
      "client:storage"
    ],
    "css": "dist/src/client.css"
  },
  "settingsSchema": {
    "fields": [
      {
        "key": "apiKey",
        "label": "API Key",
        "type": "password",
        "description": "Secret token used to authenticate against the remote service.",
        "required": true
      },
      {
        "key": "syncIntervalMinutes",
        "label": "Sync Interval (minutes)",
        "type": "number",
        "default": 30
      },
      {
        "key": "enabled",
        "label": "Enable background sync",
        "type": "boolean",
        "default": true
      },
      {
        "key": "mode",
        "label": "Sync Mode",
        "type": "select",
        "default": "incremental",
        "options": [
          {
            "label": "Incremental",
            "value": "incremental"
          },
          {
            "label": "Full",
            "value": "full"
          }
        ]
      }
    ]
  },
