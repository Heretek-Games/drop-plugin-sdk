{
  "$schema": "https://droposs.org/schemas/drop-plugin.schema.json",
  "id": "starter-plugin",
  "name": "Starter Plugin",
  "version": "1.0.0",
  "description": "Scaffolded Drop plugin template",
  "author": "Heretek Games",
  "license": "MIT",
  "apiVersion": 2,
  "targets": ["server", "client"],
  "trust": "trusted",
  "storageVersion": 1,
  "capabilities": ["routes", "storage", "events"],
  "server": {
    "entry": "dist/src/index.js",
    "source": "src/index.ts",
    "capabilities": ["routes", "storage", "events"]
  },
  "client": {
    "entry": "dist/src/client.js",
    "source": "src/client.ts",
    "capabilities": [
      "ui:slot",
      "ui:play-action",
      "game:launch-hook",
      "client:storage"
    ]
  }
}
